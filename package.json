{
  "name": "@webship.co/workspace-docksal",
  "version": "1.0.0",
  "description": "Docksal for Webship Workspace: the DOCKSAL menu on every project with a .docksal/ folder (start, stop, restart, status, logs, bash, init, remove), the up/down caption, the virtual host as the site link. A runtime of @webship.co/workspace-container.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-docksal.git"
  },
  "files": [
    "dist/src",
    "features",
    "scripts",
    "README.md",
    "ddev",
    "host-mounts.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "docksal",
    "label": "Docksal",
    "typeActions": {
      "docksal": [
        "sites",
        "code"
      ]
    },
    "scripts": {
      "hostInstall": "scripts/host-install.sh"
    },
    "features": [
      "features/docksal.feature"
    ],
    "ddev": {
      "compose": [
        "ddev/docker-compose.docksal.yaml"
      ],
      "hostMounts": [
        "~/.docksal"
      ]
    }
  },
  "dependencies": {
    "@webship.co/workspace-container": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@webship.co/workspace-docksal",
  "version": "1.0.8",
  "description": "Docksal for Webship Workspace: the DOCKSAL menu on every project with a .docksal/ folder (start, stop, restart, status, logs, bash, init, remove), the up/down caption, the virtual host as the site link. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt. A runtime of @webship.co/workspace-container.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-docksal.git"
  },
  "files": [
    "dist/src",
    "ai",
    "features",
    "scripts",
    "README.md",
    "ddev",
    "host-mounts.txt",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "docksal",
    "label": "Docksal",
    "needs": {
      "plugins": [
        "ai-agents",
        "ai-skills",
        "ai-commands",
        "ai-prompts"
      ],
      "commands": [
        {
          "command": "fin",
          "hint": "https://docs.docksal.io/getting-started/setup/"
        }
      ]
    },
    "typeActions": {
      "docksal": [
        "sites",
        "code"
      ]
    },
    "scripts": {
      "hostInstall": "scripts/host-install.sh"
    },
    "ai": {
      "agents": [
        "ai/agents/docksal-operator.md"
      ],
      "skills": [
        "ai/skills/docksal-menu"
      ],
      "commands": [
        "ai/commands/docksal-status.md"
      ],
      "prompts": [
        "ai/prompts/docksal-up-and-check.md"
      ]
    },
    "features": [
      "features/docksal.feature"
    ],
    "ddev": {
      "compose": [
        "ddev/docker-compose.docksal.yaml"
      ],
      "hostMounts": [
        "~/.docksal"
      ]
    }
  },
  "dependencies": {
    "@webship.co/workspace-container": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
